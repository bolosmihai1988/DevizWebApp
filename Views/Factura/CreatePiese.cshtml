@model DevizWebApp.Models.FacturaPieseModel

@{
    ViewData["Title"] = "Factură piese fără deviz";
}

<h2>Factură piese (fără deviz)</h2>

<form asp-action="CreatePiese" method="post">

    <div class="mb-3">
        <label>Client</label>
        <input asp-for="ClientNume" class="form-control" placeholder="Nume client" />
    </div>

    <div class="mb-3">
        <label>CUI</label>
        <input asp-for="ClientCUI" class="form-control" placeholder="CUI (opțional)" />
    </div>

    <div class="mb-3">
        <label>Adresă</label>
        <input asp-for="ClientAdresa" class="form-control" placeholder="Adresă (opțional)" />
    </div>

    <hr />

    <h4>Piese</h4>

    <table class="table table-bordered" id="pieseTable">
        <thead>
            <tr>
                <th>Denumire</th>
                <th>UM</th>
                <th>Cantitate</th>
                <th>Preț (RON)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><input name="Piese[0].Denumire" class="form-control" placeholder="Denumire piesă" /></td>
                <td><input name="Piese[0].UM" class="form-control" value="buc" /></td>
                <td><input name="Piese[0].Cantitate" type="number" step="0.01" value="1" class="form-control" /></td>
                <td><input name="Piese[0].PretUnitar" type="number" step="0.01" class="form-control" /></td>
                <td>
                    <button type="button" class="btn btn-danger" onclick="removeRow(this)">✖</button>
                </td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addRow()">➕ Adaugă piesă</button>

    <br /><br />
    <button type="submit" class="btn btn-success">Generează factura</button>
</form>

<script>
let index = 1;

function addRow() {
    const row = `
    <tr>
        <td><input name="Piese[${index}].Denumire" class="form-control" placeholder="Denumire piesă" /></td>
        <td><input name="Piese[${index}].UM" class="form-control" value="buc" /></td>
        <td><input name="Piese[${index}].Cantitate" type="number" step="0.01" value="1" class="form-control" /></td>
        <td><input name="Piese[${index}].PretUnitar" type="number" step="0.01" class="form-control" /></td>
        <td><button type="button" class="btn btn-danger" onclick="removeRow(this)">✖</button></td>
    </tr>`;
    document.querySelector("#pieseTable tbody").insertAdjacentHTML("beforeend", row);
    index++;
}

function removeRow(btn) {
    btn.closest("tr").remove();
}
</script>
