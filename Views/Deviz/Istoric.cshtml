@model DevizWebApp.Models.IstoricViewModel

@{
    ViewData["Title"] = "Istoric";
}

<h2>Istoric</h2>

<div style="display:flex; gap:20px; align-items:flex-start;">
    <!-- STÂNGA: DEVIZE + SELECTARE -->
    <div style="flex:1;">
        <h3>Devize</h3>

        <form method="post" asp-controller="Factura" asp-action="CreateFromDevize">
            @Html.AntiForgeryToken()

            <table class="table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nr</th>
                        <th>Data</th>
                        <th>Firmă</th>
                        <th>Mașină</th>
                        <th>Nr</th>
                        <th>Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Devize)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="devizIds" value="@d.Id" />
                        </td>
                        <td>@d.NrDeviz.ToString("D4")</td>
                        <td>@d.Data</td>
                        <td>@d.Firma</td>
                        <td>@d.Masina</td>
                        <td>@d.NrInmat</td>
                        <td style="white-space:nowrap;">
                            <a class="btn btn-sm btn-secondary"
                               asp-controller="Deviz"
                               asp-action="DownloadDevizPdf"
                               asp-route-id="@d.Id">
                                PDF
                            </a>

                            <form method="post"
                                  asp-controller="Deviz"
                                  asp-action="DeleteDeviz"
                                  asp-route-id="@d.Id"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Sigur vrei să ștergi devizul?');">
                                    Șterge
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <button type="submit" class="btn btn-primary">
                Creează factură din devizele selectate
            </button>
        </form>
    </div>

    <!-- DREAPTA: FACTURI -->
    <div style="flex:1;">
        <h3>Facturi</h3>

        <a class="btn btn-success mb-2"
           asp-controller="Factura"
           asp-action="CreatePiese">
            ➕ Factură piese (fără deviz)
        </a>

        <table class="table">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Data</th>
                    <th>Client</th>
                    <th>Total</th>
                    <th>Acțiuni</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var f in Model.Facturi)
            {
                <tr>
                    <td>@f.NrFactura.ToString("D4")</td>
                    <td>@f.Data</td>
                    <td>@f.ClientNume</td>
                    <td>@f.TotalGeneral.ToString("0.00")</td>
                    <td style="white-space:nowrap;">
                        <a class="btn btn-sm btn-secondary"
                           asp-controller="Factura"
                           asp-action="DownloadFacturaPdf"
                           asp-route-id="@f.Id">
                            PDF
                        </a>

                        <form method="post"
                              asp-controller="Factura"
                              asp-action="DeleteFactura"
                              asp-route-id="@f.Id"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Sigur vrei să ștergi factura?');">
                                Șterge
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
