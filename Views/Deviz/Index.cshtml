@model DevizWebApp.Models.DevizDocumentModel

@{
    ViewData["Title"] = "Creează deviz";
}

<div style="display:flex; gap:12px; margin-bottom:15px;">
    <a class="btn btn-secondary"
       asp-controller="Deviz"
       asp-action="Istoric">
        📜 Istoric devize & facturi
    </a>

    <a class="btn btn-success"
       asp-controller="Factura"
       asp-action="CreatePiese">
        ➕ Factură doar piese
    </a>
</div>

<h2>Creează deviz</h2>

<form asp-action="GeneratePDF" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            <h4>Date client</h4>
            <input asp-for="Firma" class="form-control mb-2" placeholder="Firmă / Client" />
            <input asp-for="CUI" class="form-control mb-2" placeholder="CUI" />
            <input asp-for="Adresa" class="form-control mb-2" placeholder="Adresă" />
            <input asp-for="Telefon" class="form-control mb-2" placeholder="Telefon" />
        </div>

        <div class="col-md-6">
            <h4>Date mașină</h4>
            <input asp-for="Masina" class="form-control mb-2" placeholder="Mașină" />
            <input asp-for="NrInmat" class="form-control mb-2" placeholder="Nr. înmatriculare" />
            <input asp-for="KM" class="form-control mb-2" placeholder="KM" />
            <input asp-for="SerieCaroserie" class="form-control mb-2" placeholder="Serie caroserie" />
            <input asp-for="SerieMotor" class="form-control mb-2" placeholder="Serie motor" />
        </div>
    </div>

    <h4 class="mt-3">Constatare</h4>
    <textarea asp-for="Constatare" class="form-control mb-2"></textarea>

    <h4>Lucrări convenite</h4>
    <textarea asp-for="LucrariConvenite" class="form-control mb-2"></textarea>

    <h4>Piese aduse de client</h4>
    <textarea asp-for="PieseAduseClient" class="form-control mb-3"></textarea>

    <h4>Piese</h4>
    <table class="table">
        <thead>
            <tr><th>Denumire</th><th>Cantitate</th><th>Preț</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Piese.Count; i++)
            {
                <tr>
                    <td><input asp-for="Piese[i].Denumire" class="form-control" /></td>
                    <td><input asp-for="Piese[i].Cantitate" class="form-control" /></td>
                    <td><input asp-for="Piese[i].PretUnitar" class="form-control" /></td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Manoperă</h4>
    <table class="table">
        <thead>
            <tr><th>Denumire</th><th>Ore</th><th>Preț/oră</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Manopera.Count; i++)
            {
                <tr>
                    <td><input asp-for="Manopera[i].Denumire" class="form-control" /></td>
                    <td><input asp-for="Manopera[i].Cantitate" class="form-control" /></td>
                    <td><input asp-for="Manopera[i].PretUnitar" class="form-control" /></td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary btn-lg mt-3">Generează deviz PDF</button>
</form>
