@model DevizWebApp.Models.DevizDocumentModel
@{
    ViewData["Title"] = "Deviz nou";
}

<div style="max-width:1100px;margin:auto">

    <div style="display:flex;justify-content:space-between;align-items:center;margin:18px 0;">
        <h2 style="margin:0">🛠 Deviz nou</h2>

        <div style="display:flex;gap:10px">
            <a class="btn btn-outline-secondary"
               asp-controller="Deviz"
               asp-action="Istoric">
                📜 Istoric
            </a>

            <a class="btn btn-outline-success"
               asp-controller="Factura"
               asp-action="CreatePiese">
                ➕ Factură piese
            </a>
        </div>
    </div>

    <div style="background:white;padding:22px;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.08)">

<form method="post" asp-action="GeneratePDF">

<h5 class="text-primary">Client</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label>Data</label>
        <input asp-for="Data" class="form-control" placeholder="dd.MM.yyyy" />
    </div>
    <div class="col-md-6">
        <label>Firmă</label>
        <input asp-for="Firma" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Telefon</label>
        <input asp-for="Telefon" class="form-control" />
    </div>
    <div class="col-md-12">
        <label>Adresă</label>
        <input asp-for="Adresa" class="form-control" />
    </div>
</div>

<hr/>

<h5 class="text-primary">Mașină</h5>
<div class="row g-3">
    <div class="col-md-6">
        <label>Mașină</label>
        <input asp-for="Masina" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Nr. înmatriculare</label>
        <input asp-for="NrInmat" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>KM</label>
        <input asp-for="KM" class="form-control" />
    </div>
    <div class="col-md-6">
        <label>Serie caroserie</label>
        <input asp-for="SerieCaroserie" class="form-control" />
    </div>
    <div class="col-md-6">
        <label>Serie motor</label>
        <input asp-for="SerieMotor" class="form-control" />
    </div>
</div>

<hr/>

<h5 class="text-primary">Detalii</h5>
<div class="mb-2">
    <label>Constatare</label>
    <textarea asp-for="Constatare" class="form-control" rows="2"></textarea>
</div>
<div class="mb-2">
    <label>Lucrări convenite</label>
    <textarea asp-for="LucrariConvenite" class="form-control" rows="2"></textarea>
</div>
<div class="mb-2">
    <label>Piese aduse de client</label>
    <textarea asp-for="PieseAduseClient" class="form-control" rows="2"></textarea>
</div>

<hr/>

<div style="display:flex;justify-content:space-between;align-items:center">
    <h5 class="text-primary" style="margin:0">Piese</h5>
    <button type="button" class="btn btn-sm btn-secondary" onclick="addPiesa()">➕ Adaugă piesă</button>
</div>

<table class="table table-bordered mt-2" id="pieseTable">
<thead>
<tr>
<th>Denumire</th><th style="width:120px">Cant.</th><th style="width:160px">Preț</th><th style="width:60px"></th>
</tr>
</thead>
<tbody>
<tr>
<td><input name="Piese[0].Denumire" class="form-control"/></td>
<td><input name="Piese[0].Cantitate" type="number" step="0.01" value="1" class="form-control"/></td>
<td><input name="Piese[0].PretUnitar" type="number" step="0.01" class="form-control"/></td>
<td class="text-center"><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">✖</button></td>
</tr>
</tbody>
</table>

<div style="display:flex;justify-content:space-between;align-items:center;margin-top:18px">
    <h5 class="text-primary" style="margin:0">Manoperă</h5>
    <button type="button" class="btn btn-sm btn-secondary" onclick="addManopera()">➕ Adaugă manoperă</button>
</div>

<table class="table table-bordered mt-2" id="manoperaTable">
<thead>
<tr>
<th>Denumire</th><th style="width:120px">Ore</th><th style="width:160px">Preț/oră</th><th style="width:60px"></th>
</tr>
</thead>
<tbody>
<tr>
<td><input name="Manopera[0].Denumire" class="form-control"/></td>
<td><input name="Manopera[0].Cantitate" type="number" step="0.01" value="1" class="form-control"/></td>
<td><input name="Manopera[0].PretUnitar" type="number" step="0.01" class="form-control"/></td>
<td class="text-center"><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">✖</button></td>
</tr>
</tbody>
</table>

<div class="text-end mt-4">
    <button class="btn btn-primary btn-lg">📄 Generează deviz PDF</button>
</div>

</form>
</div>
</div>

<script>
let pieseIndex = 1, manoperaIndex = 1;
function addPiesa(){
document.querySelector("#pieseTable tbody").insertAdjacentHTML("beforeend",
`<tr>
<td><input name="Piese[${pieseIndex}].Denumire" class="form-control"/></td>
<td><input name="Piese[${pieseIndex}].Cantitate" type="number" step="0.01" value="1" class="form-control"/></td>
<td><input name="Piese[${pieseIndex}].PretUnitar" type="number" step="0.01" class="form-control"/></td>
<td class="text-center"><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">✖</button></td>
</tr>`); pieseIndex++;}

function addManopera(){
document.querySelector("#manoperaTable tbody").insertAdjacentHTML("beforeend",
`<tr>
<td><input name="Manopera[${manoperaIndex}].Denumire" class="form-control"/></td>
<td><input name="Manopera[${manoperaIndex}].Cantitate" type="number" step="0.01" value="1" class="form-control"/></td>
<td><input name="Manopera[${manoperaIndex}].PretUnitar" type="number" step="0.01" class="form-control"/></td>
<td class="text-center"><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">✖</button></td>
</tr>`); manoperaIndex++;}

function removeRow(btn){
const tbody = btn.closest("tbody"); btn.closest("tr").remove();
if(tbody.children.length===0){ if(tbody.parentElement.id==="pieseTable") addPiesa(); else addManopera(); }
}
</script>
